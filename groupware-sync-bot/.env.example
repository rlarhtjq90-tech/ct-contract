# 그룹웨어 서비스 계정 (가능하면 이 연동 전용으로 발급된 제한 권한 계정 사용 권장)
GW_LOGIN_URL=https://portal.ctgroup.co.kr/
GW_USER_ID=
GW_USER_PASSWORD=

# 전자결재 > 기결문서 화면 (지금 확인한 URL)
GW_LIST_URL=https://portal.ctgroup.co.kr/#/UB/UB/UBA0000?specialLnb=Y&moduleCode=UB&menuCode=UBA&pageCode=UBA2030

# 로그인 폼 셀렉터 — 실제 로그아웃 화면을 보고 1회 확인/수정 필요 (README 참고)
GW_ID_SELECTOR=input[name="userId"], input#userId, input[type="text"]
GW_PW_SELECTOR=input[name="password"], input#password, input[type="password"]
GW_SUBMIT_SELECTOR=button[type="submit"], button:has-text("로그인")

# ct-contract 백엔드
CT_API_BASE=https://ct-contract-backend.vercel.app/api
CT_INGEST_API_KEY=

# 몇 일 전까지 재조회할지 (겹쳐도 서버가 중복은 자동 스킵함)
SYNC_DAYS_BACK=7

# true면 브라우저 창을 띄워서 보여줌 (최초 점검용), false면 headless
HEADED=false
